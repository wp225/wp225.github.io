      "text": "self.cnn (nn.Sequential)\n- Conv2d(1, chan1, 11, padding=\"same\") + LeakyReLU +\nMaxPool2d((8,1)) + Dropout2d(p)\n- Conv2d(chan1, chan2, 5, padding=\"same\") + LeakyReLU +\nMaxPool2d((4,1)) + Dropout2d(p)\n- Conv2d(chan2, chan3, 3, padding=\"same\") + LeakyReLU +\nMaxPool2d((2,1)) + Dropout2d(p/2)",
      "fontSize": 16,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
